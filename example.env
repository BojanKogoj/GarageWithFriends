# Copy this file to .env and fill in the values.
# Never commit .env, since it holds secrets.

# set hostname for tailscale container, e.g.: garage-node1
TS_HOSTNAME=your-node-name

# Tailscale coordination server, for example a Headscale instance.
# Use https://controlplane.tailscale.com for the official Tailscale service.
TS_LOGIN_SERVER=https://headscale.example.com

# Tailscale auth key, issued by the coordination server above.
# On Headscale: headscale preauthkeys create --user <user>
TS_AUTHKEY=xxxxxxxxxxxx

# Pangolin Newt credentials.
# Pangolin shows these when you create a Newt site in its dashboard.
PANGOLIN_ENDPOINT=https://pangolin.example.com
NEWT_ID=xxxxxxxxxxxx
NEWT_SECRET=xxxxxxxxxxxx

# Garage node-to-node RPC secret. Must be identical on every node.
# Generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=xxxxxxxxxxxx

# Garage admin API bearer token.
# Generate with: openssl rand -base64 32
GARAGE_ADMIN_TOKEN=xxxxxxxxxxxx

# Garage /metrics bearer token for Prometheus.
# Generate with: openssl rand -base64 32
GARAGE_METRICS_TOKEN=xxxxxxxxxxxx

# Host directory that holds persistent data for all services.
# Garage and Tailscale store their state in subfolders of this path.
DATA_ROOT=.
